# Telosyn Notebooks for Policy Analysis — credentials template
#
# Copy this file somewhere outside the repository and point the corpus at it:
#
#     mkdir -p ~/.config/telosyn-notebooks
#     cp .env.example ~/.config/telosyn-notebooks/keys.env
#     export KRL_SECRETS_PATH=~/.config/telosyn-notebooks/keys.env
#
# These six names are the complete set the corpus will read (ALLOWED_KEYS in
# src/krl_tutorials_data/sources.py). Anything else in the file is never opened.
# Every key is free. Never commit a filled-in copy; .env is ignored.

# U.S. Census Bureau — ACS, CBP, BDS      https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Federal Reserve Bank of St. Louis — FRED  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Bureau of Labor Statistics — LAUS, QCEW   https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Bureau of Economic Analysis — ACPSA       https://apps.bea.gov/API/signup/
BEA_API_KEY=

# HUD USER — Fair Market Rents, CHAS        https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_KEY=

# api.data.gov — one key, every participating agency (FBI Crime Data Explorer)
#                                           https://api.data.gov/signup/
DATA_GOV_API_KEY=
